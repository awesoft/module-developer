$script = <<<'JS'
(function () {
    var root = document.getElementById('awesoft-debug-bar'), drawer = root.querySelector('.awesoft-db__drawer');
    var requestTabs = root.querySelector('.awesoft-db__request-tabs');
    var requestPanels = root.querySelector('.awesoft-db__request-panels');
    var viewing = root.querySelector('.awesoft-db__viewing');
    var panelUrl = root.dataset.panelUrl, tokenHeader = root.dataset.tokenHeader;
    var pageNodes = {tabs: children(requestTabs), panels: children(requestPanels)};
    var key = 'awesoft-debug-bar', saved = {};
    try { saved = JSON.parse(localStorage.getItem(key)) || {}; } catch (e) {}
    function save() { try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {} }
    function children(element) { return Array.prototype.slice.call(element.children); }
    function replaceChildren(element, nodes) {
        element.textContent = '';
        nodes.forEach(function (node) { element.appendChild(node); });
    }
    function select(code) {
        if (code && !root.querySelector('[data-panel="' + code + '"]')) { code = null; }
        root.querySelectorAll('[data-tab],[data-panel]').forEach(function (el) {
            el.classList.toggle('is-active', !!code && (el.dataset.tab === code || el.dataset.panel === code));
        });
        root.classList.toggle('has-panel', !!code);
        saved.tab = code;
        if (code && code !== 'ajax') { saved.requestTab = code; }
        save();
    }
    function setState(state) {
        root.dataset.state = state;
        saved.state = state;
        save();
    }
    // whitespace is collapsed so a search still matches across formatted SQL line breaks
    function filterRows(input) {
        var term = input.value.toLowerCase().replace(/\s+/g, ' ').trim();
        input.closest('.awesoft-db__panel').querySelectorAll('tbody tr').forEach(function (row) {
            var text = row.textContent.toLowerCase().replace(/\s+/g, ' ');
            row.classList.toggle('is-hidden', !!term && text.indexOf(term) === -1);
        });
    }
    var sqlKeywords = {};
    ('SELECT FROM WHERE AND OR NOT IN IS NULL AS ON JOIN INNER LEFT RIGHT OUTER CROSS STRAIGHT_JOIN UNION ALL '
        + 'DISTINCT ORDER GROUP BY HAVING LIMIT OFFSET ASC DESC INSERT INTO VALUES UPDATE SET DELETE REPLACE IGNORE '
        + 'DUPLICATE KEY CASE WHEN THEN ELSE END EXISTS BETWEEN LIKE REGEXP FOR USING WITH INTERVAL TRUE FALSE SHOW '
        + 'DESCRIBE START TRANSACTION COMMIT ROLLBACK BEGIN LOCK UNLOCK TABLES CREATE ALTER DROP TABLE INDEX PRIMARY '
        + 'FOREIGN REFERENCES TEMPORARY IF ENGINE DEFAULT').split(' ').forEach(function (word) {
        sqlKeywords[word] = true;
    });
    // identifier | string | bind param | number | word followed by "(" | word
    var sqlTokens = /(`[^`]*`)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|(:[A-Za-z_]\w*|\?)|(\b\d+(?:\.\d+)?\b)|(\b[A-Za-z_]\w*(?=\s*\())|(\b[A-Za-z_]\w*\b)/g;
    // backtick identifier | string | whitespace | word | parenthesis or comma | anything else
    var sqlParts = /`[^`]*`|'(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|\s+|[A-Za-z_]\w*|[(),]|[^\s`'"A-Za-z_(),]+/g;
    var sqlClauses = {SELECT: 1, FROM: 1, WHERE: 1, HAVING: 1, LIMIT: 1, SET: 1, VALUES: 1, UNION: 1};
    var sqlJoins = {LEFT: 1, RIGHT: 1, INNER: 1, CROSS: 1, OUTER: 1, NATURAL: 1};
    // one clause per line, SELECT columns and AND/OR conditions indented, subqueries nested
    function formatSql(sql) {
        var parts = sql.match(sqlParts) || [], out = '', prev = '', stack = [{indent: 0, inline: false}];
        function top() { return stack[stack.length - 1]; }
        function nextWord(i, skipParentheses) {
            for (var j = i + 1; j < parts.length; j++) {
                if (!/^\s+$/.test(parts[j]) && !(skipParentheses && parts[j] === '(')) {
                    return parts[j].toUpperCase();
                }
            }
            return '';
        }
        function newline(extra) {
            var pad = new Array(top().indent + (extra || 0) + 1).join('    ');
            var current = out.slice(out.lastIndexOf('\n') + 1);
            if (current.trim() === '') {
                out = out.slice(0, out.length - current.length) + pad;
            } else {
                out = out.replace(/ +$/, '') + '\n' + pad;
            }
        }
        parts.forEach(function (part, i) {
            var upper = part.toUpperCase(), context = top();
            if (/^\s+$/.test(part)) {
                if (out && !/[\s(]$/.test(out)) { out += ' '; }
                return;
            }
            if (part === '(') {
                // Magento often wraps subqueries twice: "( (SELECT ...) UNION ALL (SELECT ...) )"
                var subquery = nextWord(i, true) === 'SELECT';
                if (subquery && /\w$/.test(out)) { out += ' '; }
                out += '(';
                if (subquery) {
                    stack.push({indent: context.indent + 1, inline: false});
                    newline();
                } else {
                    stack.push({indent: context.indent, inline: true});
                }
                prev = part;
                return;
            }
            if (part === ')') {
                if (stack.length > 1 && !stack.pop().inline) { newline(); }
                out += ')';
                prev = part;
                return;
            }
            if (!context.inline) {
                if (part === ',' && context.clause === 'SELECT') {
                    out = out.replace(/ +$/, '') + ',';
                    newline(1);
                    prev = part;
                    return;
                }
                if (sqlClauses[upper]
                    || ((upper === 'ORDER' || upper === 'GROUP') && nextWord(i) === 'BY')
                    || (sqlJoins[upper] && !sqlJoins[prev] && /^(JOIN|OUTER)$/.test(nextWord(i)))
                    || (upper === 'JOIN' && !sqlJoins[prev])
                ) {
                    newline();
                    context.clause = upper;
                } else if ((upper === 'AND' || upper === 'OR') && !context.between) {
                    newline(1);
                }
                if (upper === 'BETWEEN') { context.between = true; }
                if (upper === 'AND') { context.between = false; }
            }
            out += part;
            prev = upper;
        });
        return out.trim();
    }
    function highlightSql(cell, text) {
        var fragment = document.createDocumentFragment(), last = 0, match, type, span;
        sqlTokens.lastIndex = 0;
        while ((match = sqlTokens.exec(text))) {
            var word = match[5] || match[6];
            if (match[1]) { type = 'identifier'; }
            else if (match[2]) { type = 'string'; }
            else if (match[3]) { type = 'param'; }
            else if (match[4]) { type = 'number'; }
            else if (sqlKeywords[word.toUpperCase()]) { type = 'keyword'; }
            else if (match[5]) { type = 'function'; }
            else { continue; }
            fragment.appendChild(document.createTextNode(text.slice(last, match.index)));
            span = document.createElement('span');
            span.className = 'awesoft-db__sql-' + type;
            span.textContent = match[0];
            fragment.appendChild(span);
            last = sqlTokens.lastIndex;
        }
        fragment.appendChild(document.createTextNode(text.slice(last)));
        cell.textContent = '';
        cell.appendChild(fragment);
    }
    function renderSql(formatted) {
        root.querySelectorAll('td[data-format=sql]').forEach(function (cell) {
            if (cell.awesoftSql === undefined) { cell.awesoftSql = cell.textContent.trim(); }
            cell.classList.toggle('is-formatted', formatted);
            highlightSql(cell, formatted ? formatSql(cell.awesoftSql) : cell.awesoftSql);
        });
        root.querySelectorAll('.awesoft-db__format').forEach(function (button) {
            button.setAttribute('aria-pressed', String(formatted));
        });
        saved.formatSql = formatted;
        save();
    }

    // AJAX: requests are listed as they finish; captured ones carry a token to load their panels
    var nativeFetch = window.fetch, ajaxCount = 0, worstStatus = 0;
    var ajaxBody = root.querySelector('[data-ajax-table] tbody');
    // the debug bar's own calls and static/media assets (RequireJS loads templates over XHR) are not listed
    function isIgnored(url) {
        var path = String(url).replace(location.origin, '');
        return String(url).indexOf(panelUrl.replace(/[?#].*$/, '')) === 0 || /^\/(pub\/)?(static|media)\//.test(path);
    }
    function shortUrl(url) { return String(url).replace(location.origin, ''); }
    function statusType(status) {
        return !status || status >= 500 ? 'error' : (status >= 400 ? 'warning' : 'ok');
    }
    function cell(row, text, className) {
        var td = row.insertCell();
        if (className) {
            var span = document.createElement('span');
            span.className = className;
            span.textContent = text;
            td.appendChild(span);
        } else {
            td.textContent = text;
        }
