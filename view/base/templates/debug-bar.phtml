        cell(row, row.awesoftRequest.method);
        badge = cell(row, status || 'ERR', 'awesoft-db__badge').firstChild;
        badge.dataset.status = statusType(status);
        cell(row, row.awesoftRequest.url);
        cell(row, Math.round(performance.now() - started) + ' ms');
        action = row.insertCell();
        if (token) {
            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'awesoft-db__inspect';
            button.textContent = 'Inspect';
            action.appendChild(button);
        } else {
            action.textContent = '-';
            action.title = 'Not profiled (other origin, web API or debug bar disabled for this area)';
