<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
  <!-- global so it runs before Magento_Csp renders its header, keeping the inline script/style allowed -->
  <event name="controller_front_send_response_before">
    <observer name="awesoft_developer_inject_debug_bar" instance="Awesoft\Developer\Observer\InjectDebugBar" />
  </event>
</config>
